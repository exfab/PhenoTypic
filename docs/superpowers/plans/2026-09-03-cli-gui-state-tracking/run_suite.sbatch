#!/bin/bash
#SBATCH --job-name=pheno-gate
#SBATCH --partition=short
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --array=0-15%16
#SBATCH --output=/bigdata/exfab/anguy344/slurm_logs/gate_%A_%a.log
set -euo pipefail

# ---------------------------------------------------------------------------
# Sharded test gate for the cli-gui-state-tracking branch.
#
# Descends from run_unit_suite.sbatch (2026-08-18 plan), widened from 24 to 48
# shards and parameterised by SCOPE so every phase gate runs through the same
# harness instead of a bespoke pytest line per phase.
#
# WIDTH, AND WHY MORE SHARDS BUY NOTHING. 16 shards, all resident (`%16`).
# The wall clock is set by the slowest single FILE, because a file is the
# atomic unit of the round-robin below. Measured over the `cligui` scope, LPT
# bin-packing gives an identical 5.22 min slowest-shard at 16, 24 AND 48 bins
# -- the floor is `integration/cli/test_phenotypic_cache_layout` (5.22 min for
# three tests). Widening past 16 halves the short shards and leaves the long
# one exactly where it is, while consuming account cap that other jobs need.
# To go below 5.22 min, split INSIDE that file (`file::class`, and the junit
# XML already exposes the class-level split points) -- not by adding shards.
#
# Historical note: this was 48 shards at `%32`.
# 32 x 8 CPU = 256 CPU against the iwheeldonlab cap of 384 CPU / 1 TB, which
# every running job in the account shares -- the headroom is deliberate so a
# concurrent spike or interactive job does not queue behind the gate. Exceeding
# an ACCOUNT cap does not fail at submit; it queues with
# Reason=AssocGrpCpuLimit, and --test-only does not catch it.
#
# CPUs-per-task stays at 8 rather than dropping to buy more shards. Several
# tests carry wall-clock budgets for spawned children -- a 1 s `import
# phenotypic`, a 20 s multiprocessing join, a 0.5 s patched read deadline -- and
# they fail under contention while passing alone. Those are documented load
# flakes, not regressions, and starving each shard manufactures more of them.
#
# Usage (submit from the worktree; do not edit this file per run):
#   sbatch run_suite.sbatch                      # full scope
#   SCOPE=unit sbatch run_suite.sbatch           # tests/unit only
#   SCOPE="tests/unit/cli tests/unit/sdk_" sbatch run_suite.sbatch
# ---------------------------------------------------------------------------

WORKTREE="${WORKTREE:-/bigdata/exfab/anguy344/PhenoTypic/.worktrees/cli-gui-state-tracking}"
SHARDS="${SHARDS:-16}"
SCOPE="${SCOPE:-cligui}"
RESULTS_DIR="${RESULTS_DIR:-/bigdata/exfab/anguy344/slurm_logs/gate_${SLURM_ARRAY_JOB_ID}}"

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export QT_QPA_PLATFORM=offscreen          # without this the interpreter aborts
                                          # partway through with no summary

SHARD_ID=${SLURM_ARRAY_TASK_ID}

echo "Date:   $(date -Is)"
echo "Node:   $(hostname -s)"
echo "Job:    ${SLURM_JOB_ID}"
echo "Shard:  ${SHARD_ID}/${SHARDS}"
echo "Scope:  ${SCOPE}"
echo "CPUs:   ${SLURM_CPUS_PER_TASK}"
echo "Load:   $(uptime)"
echo

cd "$WORKTREE"
echo "Commit under test: $(git rev-parse --short HEAD) $(git log -1 --format=%s)"
echo

# --- Scope selection -------------------------------------------------------
case "$SCOPE" in
    cligui)
        # THE DEFAULT, and the routine phase gate (user, 2026-09-05). This
        # branch edits `_cli/`, `sdk_/` and `gui/`; nothing else is reachable
        # from it, and the excluded suites are where all the wall clock lives.
        #
        # Measured on the lane-3 junit XML, not estimated:
        #   in  scope  611 files  7117 tests   38.1 min CPU
        #   out scope  692 files  4983 tests  109.0 min CPU
        # so this keeps 59% of the TESTS while dropping 74% of the TIME.
        #
        # The four heaviest dropped entries alone are ~58 min of CPU and touch
        # no `_cli/` or `sdk_/` module:
        #   20.67 min ( 7 tests) unit/measure/test_measure_grid_spatial
        #   17.85 min (149     ) migration/test_equivalence   <- known-red
        #   11.47 min ( 53     ) unit/measure/test_measure_orientation_zones
        #    8.17 min ( 20     ) unit/core/test_image_pipeline
        #
        # `integration/cli` is IN, deliberately and non-negotiably: a narrow
        # lane that dropped tests/integration is what hid `--mode migrate`'s
        # total breakage (drift entry 28).
        SEARCH_ROOTS=(
            tests/unit/cli tests/unit/sdk_ tests/unit/gui
            tests/gui tests/integration/cli tests/integration/gui
        )
        ;;
    full)
        # End of run, and once per phase-set -- NOT per gate.
        SEARCH_ROOTS=(tests/unit tests/gui tests/integration tests/smoke tests/migration)
        ;;
    unit)
        SEARCH_ROOTS=(tests/unit)
        ;;
    *)
        # An explicit space-separated path list, for a phase gate.
        read -r -a SEARCH_ROOTS <<< "$SCOPE"
        ;;
esac

for root in "${SEARCH_ROOTS[@]}"; do
    if [[ ! -e "$root" ]]; then
        echo "Scope path does not exist: ${root}" >&2
        exit 2
    fi
done

mapfile -t ALL_TEST_FILES < <(
    find "${SEARCH_ROOTS[@]}" -type f -name 'test_*.py' -print | LC_ALL=C sort
)

# Round-robin over the SORTED list. Deterministic and stateless, so a re-run of
# one shard reproduces exactly the same file set -- which is what makes "run the
# failing shard again alone" a valid triage step. Note the corollary: adding a
# test file reshuffles every shard's membership, so a flake can appear to move
# between shards without anything having changed.
declare -a TEST_TARGETS=()
for file_index in "${!ALL_TEST_FILES[@]}"; do
    if ((file_index % SHARDS == SHARD_ID)); then
        TEST_TARGETS+=("${ALL_TEST_FILES[file_index]}")
    fi
done

if ((${#TEST_TARGETS[@]} == 0)); then
    echo "Shard ${SHARD_ID} has no test files (scope may be narrower than SHARDS)"
    exit 0
fi

echo "Discovered files: ${#ALL_TEST_FILES[@]}"
echo "Shard files:      ${#TEST_TARGETS[@]}"
printf '  %s\n' "${TEST_TARGETS[@]}"
echo

# Tests model ordinary jobs and intentionally mock SLURM_JOB_ID. Do not leak
# this runner's array identity into their subject -- a staged-controller test
# that reads SLURM_ARRAY_TASK_ID would otherwise see the gate's, not its own.
unset SLURM_ARRAY_JOB_ID SLURM_ARRAY_TASK_ID SLURM_ARRAY_TASK_COUNT
unset SLURM_ARRAY_TASK_MIN SLURM_ARRAY_TASK_MAX SLURM_ARRAY_TASK_STEP

mkdir -p "$RESULTS_DIR"

# -o addopts= clears the repository default, which streams uncaptured output and
# can triple runtime when stdout is a file on shared storage. `not slow` is then
# restored explicitly because clearing addopts dropped it.
# No -n: sharding IS the parallelism here, and xdist inside a shard would read
# the node's core count rather than this allocation's.
# No -x: it truncates a run that then gets recorded as a baseline.
pytest_status=0
uv run python -m pytest "${TEST_TARGETS[@]}" -q --no-header \
    -p no:randomly -o addopts= -m "not slow" \
    --junitxml="${RESULTS_DIR}/shard_${SHARD_ID}.xml" || pytest_status=$?

echo
echo "shard ${SHARD_ID} exit status: ${pytest_status}"
echo "Finished: $(date -Is)"

# Exit 0 on test failures (1) so one red shard does not mask the others in the
# array summary; a genuine harness fault (>1) still fails loudly. The junit XML
# is the authority -- collect_results.py reads it.
if ((pytest_status > 1)); then
    exit "$pytest_status"
fi
exit 0
