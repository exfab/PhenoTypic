# Documentation build artifacts
docs/build/
docs/_build/
docs/source/api_reference/api/

# Sphinx pages generated at `builder-inited` time. Tracking these in git
# invites silent staleness — e.g. someone editing a MeasurementInfo
# description without running the docs build would leave the committed
# .rst inconsistent with the source of truth. The pages are deterministic
# functions of code already under version control, so the build always
# reconstructs them.
#   - downloads.rst <- generate_downloadables_rst (docs/source/conf.py)
#   - measurements_ref/ <- _generate (docs/source/_extensions/measurements_ref.py)
#   - _static/measurements/ <- _copy_measurement_assets (mirrors packaged
#     phenotypic/_assets/measurements/ so /_static/measurements/* image refs resolve)
docs/source/downloads.rst
docs/source/measurements_ref/
docs/source/_static/measurements/

# Project-specific
deprecated/
_JupyterPrototypes/
debug/
scratch/

